# Copy to .env and fill in. Takes about 10 minutes total.

# ── HydraDB ── the evidence layer. https://app.hydradb.com
# Create a database, then connect your tools under Connectors.
HYDRA_DB_API_KEY=
HYDRA_DB_DATABASE=

# ── Pipeshift ── the diagnosis. https://dashboard.pipeshift.com
# Add a "Serverless API" model, then copy its exact id from View endpoint.
PIPESHIFT_API_KEY=
PIPESHIFT_MODEL=deepseek-ai/DeepSeek-V4-Flash

# ── InsForge ── stores every certificate. https://insforge.dev
# Dashboard > Install > API Keys. Base URL looks like https://xxx.insforge.app
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# ── RocketRide (optional) ── runs the pipeline. https://cloud.rocketride.ai
# Token is shown once. Only needed if you run the hosted pipeline.
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_AUTH=

# How many days without work before a project is dead. Tune to your team.
DEAD_AFTER_DAYS=30
