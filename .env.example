# Paste real keys into .env (never committed). One key per line, no quotes.

# HydraDB — key from app.hydradb.com
HYDRA_DB_API_KEY=

# Pipeshift — key from dashboard.pipeshift.com
PIPESHIFT_API_KEY=
# model your key can call (see dashboard); default is Meta-Llama-3-8B-Instruct
PIPESHIFT_MODEL=

# RocketRide Cloud — token from cloud.rocketride.ai (shown ONCE, copy immediately)
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_AUTH=

# InsForge — from insforge.dev dashboard (Install > API Keys)
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=
